    {
      "id": "bxyRDVGR5hCknB4mbKlSu",
      "type": "text",
      "x": -640.4420435799864,
      "y": 690.8746821675157,
      "width": 1422.0648193359375,
      "height": 201.49406375988534,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1b",
      "roundness": null,
      "seed": 1479002736,
      "version": 1908,
      "versionNonce": 826474103,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795186725787,
      "link": null,
      "locked": false,
      "text": "- Begin Timestamp is used to memorize when we started reading values \n* it represnets a Boundary / Line of where / when Tx started and we cannot read after it\n* so if transaction is left idle (for an hour for example) and then reads again \nit doesn't read the values of of the latest committed transactions that committed during that idle hour\nit reads before that established line boundary, thus no MIXING BETWEEN OLD, NEW DATA\n\n- Commit Timestamp is used to stamp records with Tx Timestamp to indicate to interleaving and future transactions\nthat this current transaction has commited successfully, thus there snapshots May or May not be stale (if there snapshot ts is < comitted ts)",
      "fontSize": 20.149406375988534,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Begin Timestamp is used to memorize when we started reading values \n* it represnets a Boundary / Line of where / when Tx started and we cannot read after it\n* so if transaction is left idle (for an hour for example) and then reads again \nit doesn't read the values of of the latest committed transactions that committed during that idle hour\nit reads before that established line boundary, thus no MIXING BETWEEN OLD, NEW DATA\n\n- Commit Timestamp is used to stamp records with Tx Timestamp to indicate to interleaving and future transactions\nthat this current transaction has commited successfully, thus there snapshots May or May not be stale (if there snapshot ts is < comitted ts)",
      "autoResize": true,
      "lineHeight": 1.25
    },
