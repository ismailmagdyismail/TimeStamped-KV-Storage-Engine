    {
      "id": "BdA4092JsKPq1Rr1TsGkS",
      "type": "text",
      "x": 1510.8157253379102,
      "y": 371.53204086275116,
      "width": 784.839599609375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 934047220,
      "version": 646,
      "versionNonce": 2082583025,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795109939518,
      "link": null,
      "locked": false,
      "text": "- Getting <<FULL>> DB Snapshot at time TN\n    - Get snapshots of all Keys values at Time stamp TN\n        - use same algorithm as Single Kv snapshot, but applied to all the keys\n    - A useful optimization here is to use an inverted structure \n        * map timestamps to Keys, values instead of Keys to TimeStamped Values\n        * kinda like a columnar format Storage",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Getting <<FULL>> DB Snapshot at time TN\n    - Get snapshots of all Keys values at Time stamp TN\n        - use same algorithm as Single Kv snapshot, but applied to all the keys\n    - A useful optimization here is to use an inverted structure \n        * map timestamps to Keys, values instead of Keys to TimeStamped Values\n        * kinda like a columnar format Storage",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XIs1XD_cpDpRFA1EzUxVe",
      "type": "text",
      "x": 1505.4906667610105,
      "y": 203.69711765123822,
      "width": 802.07958984375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
