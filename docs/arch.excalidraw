      "seed": 920033780,
      "version": 592,
      "versionNonce": 232278993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795109939518,
      "link": null,
      "locked": false,
      "text": "- Getting Key-Value snapshot at time TN\n    - find Key\n    - Binary search on Values with Tx, where x <= N\n        * in otherwords find value that is at least has Timestamp N or less than N",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Getting Key-Value snapshot at time TN\n    - find Key\n    - Binary search on Values with Tx, where x <= N\n        * in otherwords find value that is at least has Timestamp N or less than N",
      "autoResize": true,
      "lineHeight": 1.25
    },
